// Cylixin Feature Verification & Demo Script

fun is_even(num: int): bool then
    return num % 2 == 0;
endfun

// === Step 5: endfun when — early default return ===
// If the condition is true right before the function would return,
// it returns `value` instead of the last expression.
fun clamp_positive(n: int): int then
    if n < 0 then
        n = 0;
    endif
    return n;
endfun when (n == 0): -1;

fun test_loop_control() then
    @writeln("=== 1. Loop Control (Continue & Break) ===");

    @writeln("Printing odd numbers from 1 to 9 (skipping evens with continue):");
    for i from 1 to 10 then
        if @is_even(i) then
            continue;
        endif
        @write("  Odd: ");
        @writeln(i);
    endfor

    @writeln("Testing labeled continue in nested loops:");
    for outer: x from 1 to 4 then
        for inner: y from 1 to 4 then
            if y == 2 then
                continue outer;
            endif
            @write("  x=");
            @write(x);
            @write(" y=");
            @writeln(y);
        endfor
    endfor
endfun

fun test_bitwise() then
    @writeln("=== 2. Bitwise Operators ===");
    let a: int = 12; // 1100 in binary
    let b: int = 5;  // 0101 in binary

    let and_res: int = a & b;  // 4 (0100)
    let or_res: int  = a | b;   // 13 (1101)
    let shl_res: int = b << 2; // 20
    let shr_res: int = a >> 1; // 6

    @write("  12 & 5  = ");
    @writeln(and_res);
    @write("  12 | 5  = ");
    @writeln(or_res);
    @write("  5 << 2  = ");
    @writeln(shl_res);
    @write("  12 >> 1 = ");
    @writeln(shr_res);
endfun

fun test_arrays() then
    @writeln("=== 3. Array Operations ===");
    let numbers: arr<int> = [10, 20, 30, 40];
    @write("  Original index 0: ");
    @writeln(numbers[0]);

    numbers[0] = 99;
    @write("  Modified index 0: ");
    @writeln(numbers[0]);
endfun

fun test_endfun_when() then
    @writeln("=== 4. endfun when ===");
    let r1: int = @clamp_positive(5);
    let r2: int = @clamp_positive(-3);
    @write("  clamp_positive(5)  = ");
    @writeln(r1);
    @write("  clamp_positive(-3) = ");
    @writeln(r2);
endfun

fun test_dic_types() then
    @writeln("=== 5. dic<K, V> Two-Param Generics ===");
    // dic<int, int> annotation now parses correctly
    let scores: dic<int, int> = {1: 100, 2: 200, 3: 300};
    @writeln("  Dictionary declared with dic<int, int> annotation");
endfun

fun test_empty() then
    @writeln("=== 6. empty Keyword (Zero/Default Values) ===");

    let i: int    = empty;     // 0
    let f: float  = empty;     // 0.0
    let b: bool   = empty;     // false (0)
    let s: string = empty;     // ""
    let c: char   = empty;     // '\0' (0)

    @write("  int    empty = ");
    @writeln(i);
    @write("  float  empty = ");
    @writeln(f);
    @write("  bool   empty = ");
    @writeln(b);
    @write("  string empty = '");
    @write(s);
    @writeln("'");
    @write("  char   empty = (ascii) ");
    @writeln(c);

    // empty also works for containers
    let arr_empty: arr<int>     = empty;
    let set_empty: set<int>     = empty;
    let dic_empty: dic<int,int> = empty;
    @writeln("  arr/set/dic empty declarations OK");
endfun

// --- Execution Entry Point ---
@writeln("=================================");
@writeln("   Cylixin Language Feature Test ");
@writeln("=================================");

@test_loop_control();
@test_bitwise();
@test_arrays();
@test_endfun_when();
@test_dic_types();
@test_empty();

@writeln("=================================");
@writeln("   All features verified!        ");
@writeln("=================================");
